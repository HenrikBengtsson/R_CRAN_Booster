{
  "manifest_version": 2,

  "name": "R CRAN Booster",

  "version": "0.3.0",

  "description": "Injects additional information into an R package CRAN page",

  "author": "Henrik Bengtsson",

  "homepage_url": "https://github.com/HenrikBengtsson/R_CRAN_Booster",

  "browser_specific_settings": {
    "gecko": {
      "id": "{319a9cf5-982d-4a88-a9e3-05c4596582b0}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "icons": {
     "16": "CRANlogo_16x16.png",
     "48": "CRANlogo_48x48.png",
    "128": "CRANlogo_128x128.png"
  },

  "permissions": [
    "storage"
  ],

  "content_scripts": [
      // The settings, including the color mode, are applied as early as
      // possible, to avoid rendering the page in the wrong color mode
      {
          "matches": [
              "http://*.r-project.org/web/packages/*/index.html",
              "http://*.r-project.org/web/packages/*/",
              "https://*.r-project.org/web/packages/*/index.html",
              "https://*.r-project.org/web/packages/*/",
              "https://*.rstudio.com/web/packages/*/index.html",
              "https://*.rstudio.com/web/packages/*/"
          ],
          "js": ["settings.js"],
          "css": ["customized.css"],
          "run_at": "document_start"
      },

      // Note: Keep 'matches' in sync with the above
      {
          "matches": [
              "http://*.r-project.org/web/packages/*/index.html",
              "http://*.r-project.org/web/packages/*/",
              "https://*.r-project.org/web/packages/*/index.html",
              "https://*.r-project.org/web/packages/*/",
              "https://*.rstudio.com/web/packages/*/index.html",
              "https://*.rstudio.com/web/packages/*/"
//            "http://cran.*.edu/web/packages/*/index.html",
//            "https://cran.*.edu/web/packages//index.html*"
//            "https://*/cran/web/packages/*/index.html",
//            "https://*/CRAN/web/packages/*/index.html",
//            "https://*/cranmirror/web/packages//index.html*"
          ],
          "js": ["content-script.js"]
      }
  ],

  "page_action" : {
    "default_icon": "CRANlogo_16x16.png",
    "default_title": "The R CRAN Booster by Henrik Bengtsson & Chung-hong Chan"
  }
}
